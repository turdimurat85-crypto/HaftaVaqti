<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:padding="12dp"
    android:background="#CC14231C">
    <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:format24Hour="HH:mm" android:format12Hour="HH:mm" android:textSize="40sp" android:textColor="#FFFFFF"/>
    <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:format24Hour="EEEE, d MMMM" android:format12Hour="EEEE, d MMMM" android:textSize="15sp" android:textColor="#4FC79A"/>
</LinearLayout>
